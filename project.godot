; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pizza Doggy 3"
run/main_scene="uid://bhly82jesq508"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="uid://mgi6yw1hxwso"

[autoload]

SignalBus="*res://src/autoload/signal_bus.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/editor/inspector_tabs/plugin.cfg", "res://addons/editor/script-ide/plugin.cfg", "res://addons/editor/sprite_painter/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/editor/_Godot-IDE_/plugins": "blue"
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
